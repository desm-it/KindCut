{
  "name": "cricut-companion-app",
  "version": "2.1.1",
  "private": true,
  "description": "Local-first Cricut companion app for grandma-easy AI-assisted craft design and SliceBug-based cutting.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cricut-companion/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:slicebug": "npm run build:slicebug --workspace @cricut-companion/desktop",
    "test": "node scripts/run-platform-tests.cjs",
    "test:format": "node scripts/format-code.cjs --check",
    "format": "node scripts/format-code.cjs --write",
    "test:compiled-host": "node scripts/test-compiled-host.cjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run test:format && npm run typecheck && npm run test:policy && npm run test && npm run build && npm run test:compiled-host && npm run test:runtime-inert",
    "desktop:shell": "npm run dev:shell --workspace @cricut-companion/desktop",
    "package:desktop:dir": "npm run package:dir --workspace @cricut-companion/desktop",
    "package:desktop:mac": "npm run package:mac --workspace @cricut-companion/desktop",
    "package:desktop:win": "npm run package:win --workspace @cricut-companion/desktop",
    "test:policy": "node --test scripts/run-platform-tests.test.cjs scripts/format-code.test.cjs apps/desktop/scripts/prepare-shell-output.test.cjs",
    "test:runtime-inert": "node scripts/test-runtime-inert.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "8.20.0",
    "postcss": "8.5.15",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "^4.1.8"
  }
}
