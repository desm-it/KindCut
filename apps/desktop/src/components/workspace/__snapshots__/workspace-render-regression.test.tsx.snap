// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`preserves the workpiece, canvas, toolbar and layer DOM across responsibility extraction 1`] = `"<main class="app-shell design-shell"><div class="native-window-drag-zone app-drag" aria-hidden="true"></div><header class="design-topbar"><div class="design-brand"><button class="workspace-home-button no-drag" type="button" aria-label="Back to project start" title="Project start"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 10 3l7 6.5"></path><path d="M5 8v8a1 1 0 0 0 1 1h3v-4h2v4h3a1 1 0 0 0 1-1V8"></path></svg></button><div><p class="eyebrow">Workspace</p><h1>KindCut</h1></div></div><nav class="workspace-toolbar no-drag" role="toolbar" aria-label="Toolbar"><div class="toolbar-group"><button type="button" class="toolbar-btn" data-label="Open"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h3.586a1 1 0 0 1 .707.293L10.5 6.5H15.5A1.5 1.5 0 0 1 17 8v6a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14V6.5z"></path></svg><span class="toolbar-btn__label">Open</span></button><button type="button" class="toolbar-btn" data-label="Save"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="14" height="14" rx="2"></rect><rect x="7" y="3" width="6" height="5" rx="0.5" fill="currentColor" stroke="none"></rect><rect x="6" y="11" width="8" height="5" rx="1"></rect></svg><span class="toolbar-btn__label">Save</span></button></div><div class="toolbar-sep" aria-hidden="true"></div><div class="toolbar-group"><button type="button" class="toolbar-btn" data-label="Undo" disabled=""><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4 3.5 7.5 7 11"></path><path d="M3.5 7.5h8a5 5 0 0 1 0 10H8"></path></svg><span class="toolbar-btn__label">Undo</span></button><button type="button" class="toolbar-btn" data-label="Redo" disabled=""><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4l3.5 3.5L13 11"></path><path d="M16.5 7.5h-8a5 5 0 0 0 0 10H12"></path></svg><span class="toolbar-btn__label">Redo</span></button></div></nav><div class="design-topbar__controls no-drag"><button class="workspace-home-button no-drag" type="button" aria-label="Settings" title="Settings"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="2.5"></circle><path d="M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.22 4.22l1.06 1.06M14.72 14.72l1.06 1.06M4.22 15.78l1.06-1.06M14.72 5.28l1.06-1.06"></path></svg></button><button class="cut-button" type="button" data-native-intent="connect" disabled=""><span aria-hidden="true">▶</span>Start cut</button></div></header><section class="design-frame" aria-label="Design workspace"><aside class="tool-rail no-drag" aria-label="Tools"><button class="tool-button" type="button" aria-expanded="false"><svg aria-hidden="true" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="16" height="16" rx="2.5"></rect><path d="M3 14.5 7.5 10l3.5 3.5 2.5-2.5 5.5 5.5"></path><circle cx="14.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"></circle></svg>Image</button><button class="tool-button" type="button"><svg aria-hidden="true" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 5h10M11 5v12M8 17h6"></path></svg>Text</button><button class="tool-button" type="button" aria-expanded="false" aria-controls="shape-library-panel"><svg aria-hidden="true" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="11" width="9" height="9" rx="1.5"></rect><circle cx="15.5" cy="6.5" r="4.5"></circle></svg>Shapes</button><button class="tool-button" type="button" aria-expanded="false"><svg aria-hidden="true" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="11" r="3.2"></circle><path d="M11 9.5v3M13.5 6.5v9M16 8.5v5M18.5 10v2"></path></svg>Spotify</button></aside><section class="workspace-stage no-drag"><div class="stage-statusbar"><strong>Joy standard mat</strong><span>Light Cardstock</span><span>4.5 × 12 in</span></div><div class="ruler-corner">0</div><div class="ruler ruler--x" aria-label="X ruler in in"><span class="ruler__unit">in</span><span class="ruler__tick ruler__tick--major" style="left:260px"><em>0</em></span><span class="ruler__tick" style="left:277px"></span><span class="ruler__tick" style="left:294px"></span><span class="ruler__tick" style="left:311px"></span><span class="ruler__tick ruler__tick--major" style="left:328px"><em>1</em></span><span class="ruler__tick" style="left:345px"></span><span class="ruler__tick" style="left:362px"></span><span class="ruler__tick" style="left:379px"></span><span class="ruler__tick ruler__tick--major" style="left:396px"><em>2</em></span><span class="ruler__tick" style="left:413px"></span><span class="ruler__tick" style="left:430px"></span><span class="ruler__tick" style="left:447px"></span><span class="ruler__tick ruler__tick--major" style="left:464px"><em>3</em></span><span class="ruler__tick" style="left:481px"></span><span class="ruler__tick" style="left:498px"></span><span class="ruler__tick" style="left:515px"></span><span class="ruler__tick ruler__tick--major" style="left:532px"><em>4</em></span><span class="ruler__tick" style="left:549px"></span><span class="ruler__tick ruler__tick--major" style="left:566px"></span></div><div class="ruler ruler--y" aria-label="Y ruler in in"><span class="ruler__unit">in</span><span class="ruler__tick ruler__tick--major" style="top:90px"><em>0</em></span><span class="ruler__tick" style="top:107px"></span><span class="ruler__tick" style="top:124px"></span><span class="ruler__tick" style="top:141px"></span><span class="ruler__tick ruler__tick--major" style="top:158px"><em>1</em></span><span class="ruler__tick" style="top:175px"></span><span class="ruler__tick" style="top:192px"></span><span class="ruler__tick" style="top:209px"></span><span class="ruler__tick ruler__tick--major" style="top:226px"><em>2</em></span><span class="ruler__tick" style="top:243px"></span><span class="ruler__tick" style="top:260px"></span><span class="ruler__tick" style="top:277px"></span><span class="ruler__tick ruler__tick--major" style="top:294px"><em>3</em></span><span class="ruler__tick" style="top:311px"></span><span class="ruler__tick" style="top:328px"></span><span class="ruler__tick" style="top:345px"></span><span class="ruler__tick ruler__tick--major" style="top:362px"><em>4</em></span><span class="ruler__tick" style="top:379px"></span><span class="ruler__tick" style="top:396px"></span><span class="ruler__tick" style="top:413px"></span><span class="ruler__tick ruler__tick--major" style="top:430px"><em>5</em></span><span class="ruler__tick" style="top:447px"></span><span class="ruler__tick" style="top:464px"></span><span class="ruler__tick" style="top:481px"></span><span class="ruler__tick ruler__tick--major" style="top:498px"><em>6</em></span><span class="ruler__tick" style="top:515px"></span><span class="ruler__tick" style="top:532px"></span><span class="ruler__tick" style="top:549px"></span><span class="ruler__tick ruler__tick--major" style="top:566px"><em>7</em></span><span class="ruler__tick" style="top:583px"></span><span class="ruler__tick" style="top:600px"></span><span class="ruler__tick" style="top:617px"></span><span class="ruler__tick ruler__tick--major" style="top:634px"><em>8</em></span><span class="ruler__tick" style="top:651px"></span><span class="ruler__tick" style="top:668px"></span><span class="ruler__tick" style="top:685px"></span><span class="ruler__tick ruler__tick--major" style="top:702px"><em>9</em></span><span class="ruler__tick" style="top:719px"></span><span class="ruler__tick" style="top:736px"></span><span class="ruler__tick" style="top:753px"></span><span class="ruler__tick ruler__tick--major" style="top:770px"><em>10</em></span><span class="ruler__tick" style="top:787px"></span><span class="ruler__tick" style="top:804px"></span><span class="ruler__tick" style="top:821px"></span><span class="ruler__tick ruler__tick--major" style="top:838px"><em>11</em></span><span class="ruler__tick" style="top:855px"></span><span class="ruler__tick" style="top:872px"></span><span class="ruler__tick" style="top:889px"></span><span class="ruler__tick ruler__tick--major" style="top:906px"><em>12</em></span></div><div class="viewport"><div class="infinite-grid"></div><div class="workpiece-transform" style="transform:translate(260px, 90px) scale(0.85)"><div class="workpiece-mat workpiece-mat--standard" style="top:-80px;left:-33px;width:426px;height:1120px" aria-hidden="true"><span class="workpiece-mat__label workpiece-mat__label--right" style="top:30px;right:33px">Standard</span><span class="workpiece-mat__label workpiece-mat__label--bottom-left" style="bottom:30px;left:33px">Standard</span></div><div class="workpiece-paper" style="width:360px;height:960px;background-image:linear-gradient(rgba(41,37,33,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(41,37,33,0.06) 1px,transparent 1px);background-size:20px 20px;background-position:-1px -1px"><div class="empty-workpiece"><strong>Blank project</strong><span>Choose a shape or add your own design.</span></div></div><div class="workspace-image-layer" style="width:360px;height:960px" aria-label="Image layer"><div class="snap-guides" aria-hidden="true"></div></div></div></div><div class="zoom-controls no-drag" aria-label="Zoom"><button type="button">−</button><button type="button">85%</button><button type="button">＋</button></div></section><aside class="project-drawer no-drag"><div class="drawer-section"><p class="drawer-section__title">Workpiece</p><div class="object-settings"><div class="object-settings__row object-settings__row--mat object-settings__row--first"><label class="object-settings__label">Material</label><div class="mat-picker" role="group"><button type="button" class="material-btn material-btn--active" aria-pressed="true" title="Paper"><span class="material-icon material-icon--paper" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h7l3 3v11H5z"></path><path d="M12 3v3h3"></path></svg></span><span class="mat-btn__label">Paper</span></button><button type="button" class="material-btn" aria-pressed="false" title="Insert card"><span class="material-icon material-icon--insert" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 6 C8 4.8 5.5 4.8 3.5 5.5 L3.5 14.5 C5.5 13.8 8 13.8 10 15"></path><path d="M10 6 C12 4.8 14.5 4.8 16.5 5.5 L16.5 14.5 C14.5 13.8 12 13.8 10 15"></path></svg></span><span class="mat-btn__label">Insert card</span></button><button type="button" class="material-btn" aria-pressed="false" title="Vinyl"><span class="material-icon material-icon--vinyl" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g transform="rotate(-45 10 10)"><path d="M6 6 H12.5"></path><path d="M6 14 H12.5"></path><path d="M12.5 6 A2 4 0 0 1 12.5 14"></path><ellipse cx="6" cy="10" rx="2" ry="4"></ellipse><ellipse cx="6" cy="10" rx="0.8" ry="1.7"></ellipse></g></svg></span><span class="mat-btn__label">Vinyl</span></button></div><div class="weight-picker"><span class="weight-picker__caption">Weight</span><div class="weight-seg" role="group"><button type="button" class="weight-seg__btn weight-seg__btn--active" aria-pressed="true" title="Light"><span class="weight-icon" aria-hidden="true"><span class="weight-icon__layer"></span></span><span>Light</span></button><button type="button" class="weight-seg__btn" aria-pressed="false" title="Medium"><span class="weight-icon" aria-hidden="true"><span class="weight-icon__layer"></span><span class="weight-icon__layer"></span></span><span>Medium</span></button><button type="button" class="weight-seg__btn" aria-pressed="false" title="Heavy"><span class="weight-icon" aria-hidden="true"><span class="weight-icon__layer"></span><span class="weight-icon__layer"></span><span class="weight-icon__layer"></span></span><span>Heavy</span></button></div></div></div><div class="object-settings__row object-settings__row--mat"><label class="object-settings__label">Mat</label><div class="mat-picker" role="group"><button type="button" class="mat-btn mat-btn--active" aria-pressed="true" title="Joy standard mat"><span class="mat-btn__icon"><span class="mat-icon mat-icon--long" style="width:30px;height:80px" aria-hidden="true"><span class="mat-icon__grid"></span><span class="mat-icon__line"></span></span></span><span class="mat-btn__label">Long</span></button><button type="button" class="mat-btn" aria-pressed="false" title="Joy short mat"><span class="mat-btn__icon"><span class="mat-icon mat-icon--short" style="width:30px;height:43px" aria-hidden="true"><span class="mat-icon__grid"></span><span class="mat-icon__line"></span></span></span><span class="mat-btn__label">Short</span></button><button type="button" class="mat-btn" aria-pressed="false" title="Joy card mat"><span class="mat-btn__icon"><span class="mat-icon mat-icon--card" style="width:30px;height:42px" aria-hidden="true"><span class="mat-icon__band mat-icon__band--top"></span><span class="mat-icon__paper"></span><span class="mat-icon__band mat-icon__band--bottom"></span><span class="mat-icon__line"></span></span></span><span class="mat-btn__label">Card</span></button></div></div></div><p class="drawer-section__title" style="margin-top:16px">Card colors</p><div class="color-rows"><label class="color-row"><span class="color-row__icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="2" width="10" height="12" rx="1.5"></rect><path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3"></path></svg></span><span class="color-row__label">Paper color</span><span class="color-row__chip"><input type="color" value=""/></span></label><label class="color-row"><span class="color-row__icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="9" height="9" rx="1.5"></rect><path d="M6 11v2.5A1.5 1.5 0 0 0 7.5 15H13a1.5 1.5 0 0 0 1.5-1.5V8A1.5 1.5 0 0 0 13 6.5h-2"></path></svg></span><span class="color-row__label">Behind color</span><span class="color-row__chip" style="background-color:#8f4f2b"><input type="color" value="#8f4f2b"/></span></label></div><p class="drawer-section__title" style="margin-top:16px">Pens</p><div class="pen-hexes"><span class="pen-hex-wrap"><label class="pen-hex" title="Change pen color"><svg class="pen-hex__svg" viewBox="0 0 38 44" width="38" height="44" aria-hidden="true"><polygon points="19,2 36.32,12 36.32,32 19,42 1.68,32 1.68,12" fill="none" stroke="rgba(41,37,33,0.4)" stroke-width="2" stroke-linejoin="round"></polygon><polygon points="19,5 33.72,13.5 33.72,30.5 19,39 4.28,30.5 4.28,13.5" fill="#000000" stroke="#000000" stroke-width="2" stroke-linejoin="round"></polygon></svg><input type="color" value="#000000"/></label></span><button type="button" class="pen-hex pen-hex--add" aria-label="Add pen" title="Add pen"><svg class="pen-hex__svg" viewBox="0 0 38 44" width="38" height="44" aria-hidden="true"><polygon points="19,2 36.32,12 36.32,32 19,42 1.68,32 1.68,12" fill="rgba(41,37,33,0.07)" stroke="rgba(41,37,33,0.45)" stroke-width="2" stroke-linejoin="round"></polygon><path d="M19 14.5v15M11.5 22h15" stroke="rgba(41,37,33,0.7)" stroke-width="2" stroke-linecap="round"></path></svg></button></div></div><div class="drawer-section"><p class="drawer-section__title">Layers</p><div class="import-empty"><div class="paper-stack" aria-hidden="true"><span></span><span></span><span></span></div><p>No image chosen yet. Start with a file you already have, then KindCut will show it here.</p></div></div></aside></section></main>"`;
