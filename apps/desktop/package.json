{
  "name": "@cricut-companion/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:shell": "npm run build:shell && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:shell",
    "build:renderer": "tsc --noEmit && vite build --outDir dist/renderer",
    "build:shell": "tsc -p tsconfig.shell.json && node scripts/prepare-shell-output.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.shell.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@cricut-companion/ai-designer": "*",
    "@cricut-companion/craft-core": "*",
    "@cricut-companion/slicebug-bridge": "*",
    "@cricut-companion/svg-preflight": "*",
    "@xmldom/xmldom": "^0.8.13",
    "react": "latest",
    "react-dom": "latest",
    "react-moveable": "^0.56.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "39.2.6",
    "electron-builder": "^26.0.12"
  },
  "main": "dist/main/main.js",
  "build": {
    "appId": "nl.joeldesmit.cricut-companion",
    "productName": "KindCut",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  },
  "description": "Desktop shell for the local-first Cricut Companion app.",
  "author": "Joel De Smit"
}
