{
  "name": "@cricut-companion/desktop",
  "version": "1.2.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:shell": "npm run build:shell && concurrently -k -n vite,electron -c cyan,magenta \"npm run dev\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:shell:only": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:shell",
    "build:renderer": "tsc --noEmit && vite build --outDir dist/renderer",
    "build:shell": "tsc -p tsconfig.shell.json && node scripts/prepare-shell-output.cjs",
    "build:slicebug": "node scripts/build-slicebug-runtime.cjs",
    "verify:release-assets": "node scripts/verify-release-assets.cjs",
    "verify:slicebug": "node scripts/verify-slicebug-runtime.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.shell.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:dir": "npm run build:slicebug && npm run verify:slicebug && npm run build && electron-builder --dir --publish never",
    "package:mac": "node scripts/assert-package-host.cjs mac && npm run build:slicebug && npm run verify:slicebug && npm run build && electron-builder --mac --publish never",
    "package:win": "node scripts/assert-package-host.cjs win && npm run build:slicebug && npm run verify:slicebug && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@cricut-companion/ai-designer": "*",
    "@cricut-companion/craft-core": "*",
    "@cricut-companion/slicebug-bridge": "*",
    "@cricut-companion/svg-preflight": "*",
    "@xmldom/xmldom": "^0.8.13",
    "electron-updater": "^6.8.9",
    "potrace": "^2.1.8",
    "react": "latest",
    "react-dom": "latest",
    "react-moveable": "^0.56.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.3",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.10"
  },
  "main": "dist/main/main.js",
  "build": {
    "appId": "nl.joeldesmit.kindcut",
    "productName": "KindCut",
    "publish": [
      {
        "provider": "github",
        "owner": "desm-it",
        "repo": "KindCut",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/slicebug",
        "to": "slicebug"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    },
    "win": {
      "artifactName": "KindCut-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "KindCut-Setup-${version}.${ext}"
    }
  },
  "description": "KindCut desktop app for local-first Cricut design, preview, and SliceBug handoff.",
  "author": "Joel De Smit"
}
