{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": "src/shell",
    "outDir": "dist/main",
    "noEmit": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/shell/**/*.ts"],
  "exclude": ["src/shell/**/*.test.ts"]
}
